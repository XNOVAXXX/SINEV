# Copia este archivo a .env y completa los valores (Supabase → Settings → API)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-clave-anon
# SOLO para crear usuarios (nunca la expongas en el frontend ni la subas a Git)
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role
# Contraseñas de los usuarios internos (mínimo 8 caracteres)
ADMIN_PASSWORD=cambia-esta-contraseña
OPERADOR_PASSWORD=cambia-esta-contraseña
